<!-- FIREBASE + WEBSITE SCRIPT -->

<script type="module">

import { initializeApp }
from "https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
getAuth,
GoogleAuthProvider,
signInWithPopup,
signOut,
onAuthStateChanged
}
from "https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";

import {
getFirestore,
collection,
addDoc,
deleteDoc,
doc,
onSnapshot,
query,
orderBy,
limit,
serverTimestamp
}
from "https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";


/* FIREBASE CONFIGURATION */

const firebaseConfig = {
apiKey: "YOUR_API_KEY",
authDomain: "YOUR_PROJECT.firebaseapp.com",
projectId: "YOUR_PROJECT_ID",
storageBucket: "YOUR_STORAGE_BUCKET",
messagingSenderId: "YOUR_SENDER_ID",
appId: "YOUR_APP_ID"
};


/* ADMIN UID */

const ADMIN_UID = "YOUR_ADMIN_UID";


/* INITIALIZE FIREBASE */

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const provider = new GoogleAuthProvider();


/* WEBSITE VARIABLES */

var D = {

ko: {
docTitle:"5x5x5x50s 팀 웹사이트",
title:"5x5x5x50s 팀 웹사이트",
sub:"공식 스크립트 대시보드",
scripts:"스크립트",
commentsNav:"댓글",
h2:"무료 Require 스크립트",
theme:"테마",
avail:"사용 가능한 스크립트",
free:"무료",
price:"가격",
copiedStat:"이번 세션 복사 횟수",
need:"사용자 이름 필요",
guiP:"사용자 이름을 입력하면 스크립트가 자동으로 만들어집니다.",
ph:"사용자 이름",
antiH:"안티 리브 (Anti Leave)",
antiP:"설정 없이 복사만 하면 됩니다.",
mapH:"맵 (Map)",
mapP:"필요하면 따옴표 안에 맵 이름을 입력하세요.",
copy:"복사",
done:"복사됨!",
commentsTitle:"공개 댓글",
commentsDesc:"Google 계정으로 로그인하고 모든 사람과 의견을 공유하세요.",
signedIn:"Google 로그인됨",
logout:"로그아웃",
post:"댓글 게시",
commentPlaceholder:"댓글을 작성하세요...",
login:"Google로 로그인",
loading:"댓글 불러오는 중...",
empty:"아직 댓글이 없습니다.",
posting:"게시 중...",
delete:"삭제",
loginRequired:"먼저 Google로 로그인하세요.",
writeComment:"댓글을 작성하세요.",
postError:"댓글 게시 실패: ",
deleteConfirm:"이 댓글을 삭제하시겠습니까?",
deleteError:"댓글 삭제 실패: ",
loadError:"댓글을 불러올 수 없습니다."
},

en: {
docTitle:"5x5x5x50s Team Website",
title:"5x5x5x50s Team Website",
sub:"Official Script Dashboard",
scripts:"Scripts",
commentsNav:"Comments",
h2:"Free Require Scripts",
theme:"Theme",
avail:"Available scripts",
free:"Free",
price:"Price",
copiedStat:"Copied this session",
need:"needs username",
guiP:"Enter your username and the script is generated for you.",
ph:"Username",
antiH:"Anti Leave",
antiP:"No setup needed, just copy.",
mapH:"Map",
mapP:"Put the map name inside the quotes if needed.",
copy:"Copy",
done:"Copied!",
commentsTitle:"Public Comments",
commentsDesc:"Sign in with Google to share your thoughts with everyone.",
signedIn:"Signed in with Google",
logout:"Logout",
post:"Post Comment",
commentPlaceholder:"Write your comment...",
login:"Sign in with Google",
loading:"Loading comments...",
empty:"No comments yet.",
posting:"Posting...",
delete:"Delete",
loginRequired:"Please sign in with Google first.",
writeComment:"Please write a comment.",
postError:"Could not post: ",
deleteConfirm:"Delete this comment?",
deleteError:"Delete failed: ",
loadError:"Unable to load comments."
}

};

var lang = "ko";
var copiedCount = 0;
var currentUser = null;
var commentData = [];


/* LANGUAGE */

function setLang(l) {

if (!D[l]) return;

lang = l;

document.documentElement.lang = l;
document.title = D[l].docTitle;

document.querySelectorAll("[data-i18n]").forEach(function(el) {
el.textContent = D[l][el.dataset.i18n];
});

document.querySelectorAll("[data-i18n-ph]").forEach(function(el) {
el.placeholder = D[l][el.dataset.i18nPh];
});

document.querySelectorAll("[data-lang]").forEach(function(b) {
b.classList.toggle("on",b.dataset.lang === l);
});

try {
localStorage.setItem("lang",l);
} catch(e) {}

renderComments();

}

document.querySelectorAll("[data-lang]").forEach(function(b) {
b.addEventListener("click",function() {
setLang(b.dataset.lang);
});
});

try {
var saved = localStorage.getItem("lang");
if (saved && D[saved]) setLang(saved);
} catch(e) {}


/* GENERATE USERNAME SCRIPT */

document.getElementById("user").addEventListener("input",function(e) {

var v = e.target.value.replace(/["\\]/g,"") || "username";

document.getElementById("s1").textContent =
'require(115863508151394).load("' + v + '")';

});


/* COPY BUTTONS */

document.querySelectorAll("[data-copy]").forEach(function(b) {

b.addEventListener("click",async function() {

var t = document.getElementById(b.dataset.copy).textContent;

try {
await navigator.clipboard.writeText(t);
b.textContent = D[lang].done;

copiedCount++;
document.getElementById("copied").textContent = copiedCount;

setTimeout(function() {
b.textContent = D[lang].copy;
},1200);

} catch(e) {
alert("Clipboard access failed.");
}

});

});


/* THEME */

document.getElementById("theme").addEventListener("click",function() {

var r = document.documentElement;
var d = r.getAttribute("data-theme");

var dark = d
? d === "dark"
: matchMedia("(prefers-color-scheme: dark)").matches;

r.setAttribute("data-theme",dark ? "light" : "dark");

});


/* GOOGLE LOGIN */

document.getElementById("loginBtn").onclick = async function() {

try {
await signInWithPopup(auth,provider);
} catch(error) {
alert(error.message);
}

};


/* GOOGLE LOGOUT */

document.getElementById("logoutBtn").onclick = async function() {

try {
await signOut(auth);
} catch(error) {
alert(error.message);
}

};


/* AUTH STATE */

onAuthStateChanged(auth,function(user) {

currentUser = user;

document.getElementById("loginArea")
.classList.toggle("hidden",!!user);

document.getElementById("profileArea")
.classList.toggle("hidden",!user);

if(user) {

document.getElementById("profileName").textContent =
user.displayName || "Google User";

document.getElementById("profilePhoto").src =
user.photoURL || "";

}

renderComments();

});


/* POST COMMENT */

document.getElementById("postBtn").onclick = async function() {

if(!currentUser) {
alert(D[lang].loginRequired);
return;
}

var message = document.getElementById("commentInput")
.value.trim();

if(!message) {
alert(D[lang].writeComment);
return;
}

if(message.length > 1000) return;

var button = document.getElementById("postBtn");

button.disabled = true;
button.textContent = D[lang].posting;

try {

await addDoc(collection(db,"comments"), {

uid:currentUser.uid,

name:currentUser.displayName || "Google User",

photo:currentUser.photoURL || "",

message:message,

createdAt:serverTimestamp()

});

document.getElementById("commentInput").value = "";

} catch(error) {

alert(D[lang].postError + error.message);

}

button.disabled = false;
button.textContent = D[lang].post;

};


/* DELETE COMMENT */

async function deleteComment(id) {

if(!currentUser || currentUser.uid !== ADMIN_UID) return;

if(!confirm(D[lang].deleteConfirm)) return;

try {

await deleteDoc(doc(db,"comments",id));

} catch(error) {

alert(D[lang].deleteError + error.message);

}

}


/* RENDER COMMENTS */

function renderComments() {

var list = document.getElementById("commentList");
var status = document.getElementById("commentStatus");

list.replaceChildren();

if(!commentData.length) {

status.textContent = D[lang].empty;
return;

}

status.textContent = "";

commentData.forEach(function(item) {

var card = document.createElement("div");
card.className = "comment";

var header = document.createElement("div");
header.className = "comment-header";

var photo = document.createElement("img");
photo.className = "comment-avatar";
photo.alt = "";
photo.src = item.photo || "";

photo.onerror = function() {
photo.style.display = "none";
};

var info = document.createElement("div");

var name = document.createElement("div");
name.className = "comment-name";
name.textContent = item.name || "Google User";

var date = document.createElement("div");
date.className = "comment-date";

date.textContent = item.createdAt
? item.createdAt.toDate().toLocaleString()
: "Just now";

info.append(name,date);
header.append(photo,info);

var message = document.createElement("div");
message.className = "comment-message";
message.textContent = item.message || "";

card.append(header,message);


/* ADMIN DELETE */

if(currentUser && currentUser.uid === ADMIN_UID) {

var del = document.createElement("button");

del.className = "delete-btn";
del.textContent = D[lang].delete;

del.onclick = function() {
deleteComment(item.id);
};

card.append(del);

}

list.append(card);

});

}


/* FIRESTORE REALTIME LISTENER */

var commentsQuery = query(
collection(db,"comments"),
orderBy("createdAt","desc"),
limit(100)
);

onSnapshot(commentsQuery,function(snapshot) {

commentData = [];

snapshot.forEach(function(documentSnapshot) {

commentData.push({
id:documentSnapshot.id,
...documentSnapshot.data()
});

});

renderComments();

},function(error) {

console.error(error);

document.getElementById("commentStatus").textContent =
D[lang].loadError;

});

</script>
</body>
</html>
