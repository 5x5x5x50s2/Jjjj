
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>5x5x5x50s Team Website</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root{
--bg:#1e56e6;--surface:#fff;--text:#161827;
--muted:#6a6f88;--accent:#5865f2;--accent-t:#fff;
--border:#e1e3ef;--code:#eef0fa;
padding-top:env(safe-area-inset-top,0px);
padding-bottom:env(safe-area-inset-bottom,0px)
}

@media(prefers-color-scheme:dark){
:root:not([data-theme="light"]){
--bg:#0a1f66;--surface:#181b25;--text:#eceefa;
--muted:#9096b3;--border:#272b3a;--code:#10131b
}}

:root[data-theme="dark"]{
--bg:#0a1f66;--surface:#181b25;--text:#eceefa;
--muted:#9096b3;--border:#272b3a;--code:#10131b
}

*{box-sizing:border-box}
html,body{margin:0}

body{
background:linear-gradient(160deg,var(--bg),#0b2a8f);
background-attachment:fixed;
color:var(--text);
font-family:"Poppins","Noto Sans KR",system-ui,sans-serif;
line-height:1.5
}

.wrap{display:flex;min-height:100vh}

aside{
width:220px;background:var(--surface);
border-right:1px solid var(--border);
padding:20px 16px;flex-shrink:0
}

aside h1{font-size:18px;margin:0 0 20px}

aside a{
display:block;padding:9px 12px;border-radius:8px;
color:var(--muted);text-decoration:none;
font-size:14px;margin-bottom:4px
}

aside a.active,aside a:hover{
background:var(--code);color:var(--text)
}

main{flex:1;padding:24px;min-width:0;max-width:900px}

.top{
display:flex;justify-content:space-between;
align-items:center;gap:12px;flex-wrap:wrap;
margin-bottom:20px
}

.top h2{margin:0;font-size:22px;color:#fff}

.site-title{text-align:center;margin:0 0 24px;color:#fff}

.site-title h1{
margin:0;font-size:clamp(26px,5vw,42px);
font-weight:800;letter-spacing:.5px;
text-shadow:0 2px 12px rgba(0,0,0,.3)
}

.site-title span{font-size:14px;opacity:.85}

.site-title img{
display:block;margin:0 auto 12px;width:120px;
max-width:40%;height:auto;border-radius:16px;
box-shadow:0 6px 20px rgba(0,0,0,.35)
}

.tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}

.lang{
display:flex;background:rgba(255,255,255,.18);
border-radius:99px;padding:3px
}

.lang button{
border:0;background:transparent;color:#fff;
font:inherit;font-size:13px;padding:6px 14px;
border-radius:99px;cursor:pointer
}

.lang button.on{
background:#fff;color:#1e3fae;font-weight:600
}

.btn{
background:var(--accent);color:var(--accent-t);
border:0;padding:9px 16px;border-radius:8px;
font-size:14px;cursor:pointer;text-decoration:none;
display:inline-block;font-family:inherit
}

.btn.ghost{background:var(--code);color:var(--text)}
.btn:disabled{opacity:.55;cursor:not-allowed}

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
gap:12px;margin-bottom:20px
}

.stat,.card{
background:var(--surface);
border:1px solid var(--border);
border-radius:12px;padding:16px
}

.stat b{font-size:26px;display:block}
.stat span{color:var(--muted);font-size:13px}

.card{margin-bottom:12px}
.card h3{margin:0 0 4px;font-size:16px}
.card p{margin:0 0 10px;color:var(--muted);font-size:13px}

.row{display:flex;gap:8px;align-items:stretch}

code{
flex:1;background:var(--code);padding:10px 12px;
border-radius:8px;font-family:ui-monospace,Menlo,Consolas,monospace;
font-size:13px;overflow-x:auto;white-space:nowrap
}

input,textarea{
width:100%;padding:11px 12px;
border-radius:8px;border:1px solid var(--border);
background:var(--code);color:var(--text);
font-size:14px;margin-bottom:10px;
font-family:inherit
}

textarea{resize:vertical;min-height:105px}

.tag{
font-size:11px;background:var(--code);
color:var(--muted);padding:2px 8px;
border-radius:99px;margin-left:6px;font-weight:400
}

.card h2{margin:0 0 8px;font-size:18px}
.card ul{margin:0;padding-left:20px;font-size:14px}
.card li{margin-bottom:4px}

.discord{
display:flex;justify-content:space-between;
align-items:center;gap:12px;flex-wrap:wrap;
background:var(--accent);color:var(--accent-t);
border-radius:12px;padding:18px
}

.discord a{
background:#fff;color:#5865f2;padding:9px 16px;
border-radius:8px;text-decoration:none;
font-weight:600;font-size:14px
}

/* COMMENTS */

.comment-login{
display:flex;align-items:center;
gap:12px;flex-wrap:wrap;margin-bottom:15px
}

.google-btn{
width:100%;background:#4285f4;color:white;
padding:12px;border-radius:9px;
border:0;font-family:inherit;font-weight:600;
cursor:pointer
}

.user-profile{
display:flex;align-items:center;gap:10px;
flex:1;min-width:0
}

.user-profile img,.comment-avatar{
width:42px;height:42px;border-radius:50%;
object-fit:cover;background:var(--code);
flex-shrink:0
}

.user-details{min-width:0}
.user-details strong{
display:block;overflow:hidden;text-overflow:ellipsis;
white-space:nowrap
}

.user-details small{color:var(--muted)}

.comment-form{margin-top:15px}

.comment-form button{width:100%}

.comment{
padding:15px 0;
border-bottom:1px solid var(--border);
overflow-wrap:anywhere
}

.comment-header{
display:flex;align-items:center;gap:10px
}

.comment-name{font-size:14px;font-weight:700}

.comment-date{font-size:11px;color:var(--muted)}

.comment-message{
font-size:14px;white-space:pre-wrap;
margin:12px 0;overflow-wrap:anywhere
}

.delete-btn{
background:#fee2e2;color:#dc2626;
border:0;padding:7px 12px;
border-radius:7px;cursor:pointer
}

.comment-status{
text-align:center;color:var(--muted);
font-size:13px;padding:15px 0
}

.hidden{display:none!important}

@media(max-width:640px){
.wrap{flex-direction:column}
aside{
width:100%;display:flex;gap:6px;
align-items:center;overflow-x:auto;
border-right:0;border-bottom:1px solid var(--border);
padding:12px
}
aside h1{
margin:0 8px 0 0;font-size:16px;
white-space:nowrap
}
aside a{margin:0;white-space:nowrap}
main{padding:16px}
}
</style>
</head>

